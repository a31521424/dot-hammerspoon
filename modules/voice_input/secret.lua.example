-- Copy this file to modules/voice_input/secret.lua and put your Doubao API key here.
-- (modules/voice_input/secret.lua is the canonical path; ~/.hammerspoon/voice_input_secret.lua is supported as a legacy alias)
-- Note: GUI Hammerspoon does not load ~/.zshrc, so avoid relying solely on export HAMMERSPOON_VOICE_DOUBAO_API_KEY.
return {
  apiKey = "replace-with-your-doubao-api-key",
}
