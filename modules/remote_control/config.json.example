{
  "settings": {
    "mouseSpeed": 14,
    "holdThresholdMs": 800,
    "doubleClickIntervalMs": 250,
    "mouseAcceleration": 1.2,
    "repeatDelayMs": 350,
    "repeatIntervalMs": 90,
    "targetBundleID": "com.googlecode.iterm2",
    "dangerousMacros": false
  },
  "device": {
    "vendorID": 10007,
    "productID": 12984,
    "name": "Xiaomi Bluetooth Remote 2 Pro",
    "autoApplyHidutil": true
  },
  "profiles": {
    "global": {
      "name": "iTerm2 工作流（其他应用仅主页和配置键可用）",
      "keys": {
        "voice": {
          "tap": "action:voice_input",
          "hold": "action:voice_input"
        },
        "ok": {
          "tap": "key:return",
          "hold": "key:return"
        },
        "back": {
          "tap": "key:delete",
          "hold": "key:delete",
          "repeatable": true
        },
        "menu": {
          "tap": "key:delete",
          "hold": "key:delete",
          "repeatable": true
        },
        "home": {
          "tap": "action:focus_iterm",
          "hold": "action:escape_layer"
        },
        "power": {
          "tap": "action:none",
          "hold": "action:toggle_dashboard"
        },
        "tv": {
          "tap": "action:toggle_review",
          "hold": "action:none"
        },
        "volume_up": {
          "tap": "key:pageup",
          "hold": "key:pageup",
          "repeatable": true,
          "repeatDelayMs": 500,
          "repeatIntervalMs": 250
        },
        "volume_down": {
          "tap": "key:pagedown",
          "hold": "key:pagedown",
          "repeatable": true,
          "repeatDelayMs": 500,
          "repeatIntervalMs": 250
        },
        "up": {
          "tap": "key:up",
          "hold": "key:up",
          "repeatable": true
        },
        "down": {
          "tap": "key:down",
          "hold": "key:down",
          "repeatable": true
        },
        "left": {
          "tap": "key:left",
          "hold": "key:left",
          "repeatable": true
        },
        "right": {
          "tap": "key:right",
          "hold": "key:right",
          "repeatable": true
        }
      }
    },
